<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remote_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/onBackground"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="@string/status_ready"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurfaceMuted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_power"
                style="@style/Widget.SamsungRemote.RemoteButton.Round"
                android:text="@string/power"
                app:backgroundTint="@color/power" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_source"
                style="@style/Widget.SamsungRemote.RemoteButton"
                android:layout_marginStart="12dp"
                android:text="@string/source" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_mute"
                style="@style/Widget.SamsungRemote.RemoteButton"
                android:layout_marginStart="12dp"
                android:text="@string/mute" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_volume_up"
                    style="@style/Widget.SamsungRemote.RemoteButton.Tall"
                    android:text="@string/volume_up" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    android:text="@string/volume"
                    android:textColor="@color/onSurfaceMuted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_volume_down"
                    style="@style/Widget.SamsungRemote.RemoteButton.Tall"
                    android:text="@string/volume_down" />
            </LinearLayout>

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:columnCount="3"
                android:rowCount="3">

                <Space style="@style/Widget.SamsungRemote.RemoteButton.Grid" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_up"
                    style="@style/Widget.SamsungRemote.RemoteButton.Grid"
                    android:text="@string/up" />

                <Space style="@style/Widget.SamsungRemote.RemoteButton.Grid" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_left"
                    style="@style/Widget.SamsungRemote.RemoteButton.Grid"
                    android:text="@string/left" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_ok"
                    style="@style/Widget.SamsungRemote.RemoteButton.Grid"
                    android:text="@string/ok" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_right"
                    style="@style/Widget.SamsungRemote.RemoteButton.Grid"
                    android:text="@string/right" />

                <Space style="@style/Widget.SamsungRemote.RemoteButton.Grid" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_down"
                    style="@style/Widget.SamsungRemote.RemoteButton.Grid"
                    android:text="@string/down" />

                <Space style="@style/Widget.SamsungRemote.RemoteButton.Grid" />
            </GridLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_channel_up"
                    style="@style/Widget.SamsungRemote.RemoteButton.Tall"
                    android:text="@string/channel_up" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    android:text="@string/channel"
                    android:textColor="@color/onSurfaceMuted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_channel_down"
                    style="@style/Widget.SamsungRemote.RemoteButton.Tall"
                    android:text="@string/channel_down" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_menu"
                style="@style/Widget.SamsungRemote.RemoteButton"
                android:text="@string/menu" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_home"
                style="@style/Widget.SamsungRemote.RemoteButton"
                android:layout_marginStart="12dp"
                android:text="@string/home" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_back"
                style="@style/Widget.SamsungRemote.RemoteButton"
                android:layout_marginStart="12dp"
                android:text="@string/back" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_play_pause"
            style="@style/Widget.SamsungRemote.RemoteButton.Wide"
            android:layout_marginTop="16dp"
            android:text="@string/play_pause" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:useDefaultMargins="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_1"
                style="@style/Widget.SamsungRemote.RemoteButton.Number"
                android:text="@string/one" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_2"
                style="@style/Widget.SamsungRemote.RemoteButton.Number"
                android:text="@string/two" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_3"
                style="@style/Widget.SamsungRemote.RemoteButton.Number"
                android:text="@string/three" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_4"
                style="@style/Widget.SamsungRemote.RemoteButton.Number"
                android:text="@string/four" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_5"
                style="@style/Widget.SamsungRemote.RemoteButton.Number"
                android:text="@string/five" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_6"
                style="@style/Widget.SamsungRemote.RemoteButton.Number"
                android:text="@string/six" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_7"
                style="@style/Widget.SamsungRemote.RemoteButton.Number"
                android:text="@string/seven" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_8"
                style="@style/Widget.SamsungRemote.RemoteButton.Number"
                android:text="@string/eight" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_9"
                style="@style/Widget.SamsungRemote.RemoteButton.Number"
                android:text="@string/nine" />

            <Space style="@style/Widget.SamsungRemote.RemoteButton.Number" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_0"
                style="@style/Widget.SamsungRemote.RemoteButton.Number"
                android:text="@string/zero" />
        </GridLayout>
    </LinearLayout>
</ScrollView>
